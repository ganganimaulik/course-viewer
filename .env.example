# Copy this file to .env and fill in your keys. server.js loads it on startup.

# Fireworks AI API key (used for notes, summaries, and chat): https://app.fireworks.ai/settings/users/api-keys
FIREWORKS_API_KEY=

# Modal credentials (used for audio transcription). Optional if you've run `modal token set`,
# which saves them to ~/.modal.toml.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
